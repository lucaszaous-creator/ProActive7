# Copie para .env e preencha com os dados do seu projeto Supabase.
# Estes valores sao usados pelo cliente (browser) e nao sao secretos.
VITE_SUPABASE_URL=https://glvdiicipblsohdgmqaz.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-projeto

# Elfsight — UUID do widget de Instagram Feed configurado em
# https://elfsight.com (painel "All Widgets" → o UUID aparece no
# snippet de instalacao, ex.: elfsight-app-a1b2c3d4-...-...). Deixe
# vazio para mostrar o fallback "Feed em breve" na pagina /novidades.
VITE_ELFSIGHT_INSTAGRAM_APP_ID=
